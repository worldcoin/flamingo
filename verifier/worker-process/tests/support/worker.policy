# x86_64 Linux fixture policy, NOT a production sandbox policy.
# Allows the dynamic loader, Rust runtime, RPC and deliberate descendant tests.
read: 1
write: 1
readv: 1
writev: 1
close: 1
fcntl: 1
fstat: 1
newfstatat: 1
statx: 1
lseek: 1
pread64: 1
openat: 1
access: 1
readlink: 1
readlinkat: 1
getdents64: 1
mmap: 1
mprotect: 1
munmap: 1
mremap: 1
madvise: 1
brk: 1
arch_prctl: 1
prctl: 1
prlimit64: 1
getrlimit: 1
getrandom: 1
getpid: 1
gettid: 1
getuid: 1
geteuid: 1
getgid: 1
getegid: 1
set_tid_address: 1
set_robust_list: 1
rseq: 1
rt_sigaction: 1
rt_sigprocmask: 1
rt_sigreturn: 1
sigaltstack: 1
tgkill: 1
futex: 1
clock_gettime: 1
clock_nanosleep: 1
nanosleep: 1
sched_getaffinity: 1
sched_yield: 1
clone: 1
clone3: return ENOSYS
fork: 1
wait4: 1
pause: 1
execve: 1
execveat: 1
poll: 1
ppoll: 1
ioctl: 1
setsockopt: 1
getsockopt: 1
recvfrom: 1
sendto: 1
recvmsg: 1
sendmsg: 1
shutdown: 1
exit: 1
exit_group: 1
