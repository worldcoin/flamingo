# syntax=docker/dockerfile:1
# Private deployment image; never publish via release-enclaves. The worker artifact is
# fetched from S3 at container start, not baked into the image.
FROM public.ecr.aws/amazonlinux/amazonlinux:2023
# awscli-2 is AL2023's AWS CLI v2 package.
RUN dnf install -y aws-nitro-enclaves-cli aws-nitro-enclaves-cli-devel jq coreutils awscli-2 tar gzip && dnf clean all
COPY verifier-enclave.eif /home/enclave.eif
# The uploader's Nix runtime closure lives in the carrier, outside the EIF.
COPY nix/store/ /nix/store/
COPY sandbox-bundle run-worker-enclave.sh /home/
ENV ENCLAVE_CPU_COUNT=2 ENCLAVE_MEMORY_SIZE=4096 WORKER_READY_FILE=/run/flamingo/ready
CMD ["/home/run-worker-enclave.sh"]
